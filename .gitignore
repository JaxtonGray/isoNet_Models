# Ignore the SLURM output files
slurm*
SLURM_Output/*

# Ignore the large data files, just download them from the source using the scripts
*.nc
*.grib
*.zip

# Ignore any virtual environment files
**/bin/
**/lib/
**/pyvenv.cfg

# Ignore Hyperparameter Tuning
**/Hyperparameters/*

# Ignore Logs files, they are just for debugging
Logs/*.log

# Ignore Model Keras files
*.keras
# Ignore Model H5 files
*.h5


# Ignore Stats files that are generated by the scriptscl
# Just rerun the scripts to generate them
Stats/SummaryStats/*.xlsx
Stats/Residuals/*.csv
Stats/Mapping/*

# Ignore most of the files within the KPN folder, all that include the .tif extension
# and the legend.txt file
Data/KPN/**/*.tif
Data/KPN/legend.txt

# Ignore any ipynb notebook folders
.ipynb_checkpoints/**
**/.ipynb_checkpoints/

# Ignore pycache folder
Data/__pycache__

# Ignore the test.ipynb file, it is just for testing and debugging
test.ipynb

# Ignore the Combined Results, as they are too big to be stored on GitHub, can just rerun the script loadResults.py to generate them
Results/Combined_Leave_Out_Results.csv
Results/Combined_Test_Results.csv

# Ignore any PNG files
Results/**/*.png